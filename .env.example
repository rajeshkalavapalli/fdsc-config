# SQL Server database for FDSC. This API uses its own login (fdsc_public) that can
# ONLY run dbo.SubmitEnquiry (no direct read or write on any table).
DB_SERVER=localhost
DB_DATABASE=FDSC
DB_USER=fdsc_public
DB_PASSWORD=
DB_PORT=1433
# true for Azure SQL, false for a local SQL Server
DB_ENCRYPT=false

# Website addresses allowed to send enquiries (comma separated). Empty = any origin (development only).
CORS_ORIGINS=http://localhost:5180,http://localhost:5181
PORT=5010
